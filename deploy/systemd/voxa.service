[Unit]
Description=VOXA: asistente de voz (núcleo)
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service
# Si falla 10 veces en 5 minutos, deja de insistir (algo está mal configurado).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=%h/.local/bin/voxa servicio
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
