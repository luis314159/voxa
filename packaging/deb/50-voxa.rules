// «Hey Voxa, actualízate»: quien usa la PC (sesión local y activa) puede arrancar la actualización
// de VOXA sin contraseña. Solo esa unidad y solo «start»: lo que corre ya está fijo en el paquete
// (baja el .deb más reciente del release y revisa su huella antes de instalarlo).
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "voxa-actualizar.service" &&
        action.lookup("verb") == "start" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
