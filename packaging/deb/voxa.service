[Unit]
Description=VOXA: asistente de voz (núcleo)
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/voxa servicio
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# yt-dlp y deno vienen en el entorno de VOXA; Spotifast, en ~/.local/bin (lo baja el primer arranque).
Environment=PATH=/opt/voxa/venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
